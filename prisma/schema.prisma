generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum ModerationType {
  WARNING
  MUTE
  SUSPENSION
  BAN
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  avatar      String?
  displayName String?
  role        Role     @default(MEMBER)

  games       String[] @default([])
  positions   String[] @default([])
  playstyles  String[] @default([])

  mmr         Int      @default(1000)
  rank        String   @default("Unranked")
  kvCoins     Int      @default(0)

  lastIp      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id])

  matchStats  MatchPlayer[]
  moderation  ModerationAction[]

  @@index([teamId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  tag         String   @unique
  icon        String?
  description String?
  inviteCode  String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  members     User[]
  matches     MatchTeam[]
}

model Match {
  id         String   @id @default(cuid())
  game       String
  status     String   @default("scheduled")
  result     Json?
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  teams      MatchTeam[]
  players    MatchPlayer[]
}

model MatchTeam {
  id       String @id @default(cuid())
  matchId  String
  teamId   String
  score    Int    @default(0)

  match    Match  @relation(fields: [matchId], references: [id])
  team     Team   @relation(fields: [teamId], references: [id])

  @@unique([matchId, teamId])
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  userId    String
  stats     Json?
  mmrChange Int     @default(0)

  match     Match   @relation(fields: [matchId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}

model ModerationAction {
  id        String         @id @default(cuid())
  userId    String
  type      ModerationType
  reason    String
  createdAt DateTime       @default(now())
  expiresAt DateTime?

  user      User           @relation(fields: [userId], references: [id])
}

model EventItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  startAt     DateTime
  endAt       DateTime?
  createdAt   DateTime @default(now())
}

model SiteConteudo {
  id        String   @id @default("singleton")
  titulo    String   @default("O site por dentro")
  subtitulo String   @default("Um ponto de encontro pra tudo que forma a estrutura NÊMESIS.")
  cartoes   Json     @default("[]")
  divisoes  Json     @default("[]")
  updatedAt DateTime @updatedAt
}
